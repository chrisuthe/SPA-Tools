{
  "$schema": "https://raw.githubusercontent.com/nicegui-org/nicegui/refs/heads/main/tauri_conf_schema.json",
  "productName": "SPATools",
  "version": "0.1.0",
  "identifier": "com.spatools.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "resources": {
      "../../api/**/*": "python/api/",
      "../../cli/**/*": "python/cli/",
      "../../config/**/*": "python/config/",
      "../../dtc/**/*": "python/dtc/",
      "../../ecu_tune/**/*": "python/ecu_tune/",
      "../../live_data/**/*": "python/live_data/",
      "../../module_map/**/*": "python/module_map/",
      "../../protocol/**/*": "python/protocol/",
      "../../transport/**/*": "python/transport/",
      "../../requirements.txt": "python/"
    }
  },
  "app": {
    "windows": [
      {
        "title": "SPATools",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
