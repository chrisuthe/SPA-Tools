{
  "$schema": "https://raw.githubusercontent.com/nicegui-org/nicegui/refs/heads/main/tauri_conf_schema.json",
  "productName": "SPATools",
  "version": "0.1.0",
  "identifier": "com.spatools.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "python scripts/bundle-python.py && npm run build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "python/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "SPATools",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
